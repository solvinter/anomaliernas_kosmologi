document:
  title: "Lärandenoder: lokal AI, mänskligt mentorskap och tillgänglig bildning"
  project_context:
    ecosystem: "Solvinter"
    possible_locations:
      - "Mumford"
      - "Skeppet"
    primary_use_case: "Läxhjälp och lokalt förankrat lärandestöd"
    status: "Idé- och designunderlag"

origin_of_idea:
  personal_observation:
    description: >
      Tillgång till kunskap räcker inte alltid för att en människa ska kunna
      orientera sig genom utbildning, arbetsliv och samhälle. Många har haft
      lärare, släktingar eller arbetskamrater som hjälpt dem mänskligt, men
      stödet har ofta varit sporadiskt och otillräckligt.
    structural_problem: >
      Strategisk vägledning har historiskt varit ojämnt fördelad. Barn från
      familjer med utbildade, engagerade och systemkunniga vuxna har ofta fått
      informell kunskap om hur man studerar, skriver CV, söker utbildningar,
      presenterar sin kompetens och planerar sin framtid.
    key_insight: >
      En stor del av utbildningsmässiga fördelar består inte bara av pengar
      eller formell undervisning, utan av återkommande samtal med någon som
      hjälper barnet att tänka, formulera mål och förstå systemet.

human_example:
  mentor_figure:
    identity: "Berättarens bror, född 1978"
    habits:
      - "Har läst intensivt sedan tonåren."
      - "Läser fortfarande kontinuerligt."
      - "Lyssnar på ljudböcker när han inte kan läsa."
      - "Har genom långvarig läsning tränat sitt omdöme och sitt nervsystem."
    abilities:
      - "Ser människors kompetenser och potential."
      - "Hjälper andra att formulera sina erfarenheter."
      - "Är särskilt skicklig på att skriva och förbättra CV."
      - "Kan ge strategisk vägledning genom samtal."
    symbolic_image: >
      En människa som sitter på en terrass med en bok. Läsningen är inte
      en tillfällig prestation utan en del av personens liv och identitet.
    relevance_to_ai: >
      En människa som har läst, jämfört och resonerat under årtionden kan
      påminna om en mänsklig kunskapsmodell. Skillnaden är att människans
      omdöme också har formats av relationer, ansvar, erfarenheter,
      konsekvenser och ett levt liv.

educational_problem:
  current_system:
    tendencies:
      - "Utbildning organiseras ofta efter ämnen snarare än efter elevens frågor."
      - "Alla elever förväntas följa ungefär samma väg till kunskapsmålen."
      - "Personliga förklaringar och återkommande individuell vägledning är resurskrävande."
      - "En lärare ansvarar ofta för för många elever samtidigt."
      - "Informell kunskap om utbildning och arbetsliv lärs inte ut systematiskt."
  learner_variation:
    examples:
      - >
        Vissa människor kan självständigt läsa brett och disciplinerat utan
        ett yttre mål.
      - >
        Andra fungerar bäst när kunskapen är kopplad till ett tydligt projekt,
        ett konkret problem eller en verklig uppgift.
      - >
        En person kan exempelvis lära sig Git för att dokumentera Solvinter,
        eller linjär algebra för att förstå språkmodeller.
      - >
        Vissa elever kan prestera mycket väl inom ett krävande curriculum men
        få svårt att organisera sitt lärande när den yttre strukturen försvinner.
  important_distinction:
    statement: "Brist på självorganisering är inte samma sak som brist på intelligens eller nyfikenhet."
    implication: >
      Utbildningssystem bör erbjuda struktur utan att förutsätta att alla
      elever motiveras och organiserar sig på samma sätt.

pedagogical_principles:
  central_formula: "Anpassa vägen, men inte nödvändigtvis målet."
  principles:
    - id: "meaning_before_abstraction"
      description: >
        Börja när det är möjligt i en verklig fråga, uppgift eller situation
        som eleven förstår och bryr sig om. Introducera därefter den teori som
        behövs för att komma vidare.
    - id: "project_based_motivation"
      description: >
        Projekt och praktiska problem kan skapa motivation att lära sig
        matematik, språk, programmering, historia och andra ämnen.
    - id: "shared_knowledge_goals"
      description: >
        Personalisering ska inte automatiskt betyda lägre krav. Elever kan ta
        olika vägar men ändå utveckla gemensamma grundläggande förmågor.
    - id: "discipline_as_education"
      description: >
        Skolan ska inte bara följa elevens omedelbara intresse. Den ska även
        träna koncentration, uthållighet och förmågan att följa ett resonemang
        från början till slut.
    - id: "productive_difficulty"
      description: >
        Eleven behöver gradvis lära sig att läsa svåra texter, tolerera
        frustration, återvända till problem och avsluta uppgifter även när
        motivationen varierar.
    - id: "curiosity_with_structure"
      description: >
        Nyfikenhet ger energi och riktning. Struktur gör att energin över tid
        omvandlas till sammanhängande kunskap.
    - id: "human_relationships_remain_central"
      description: >
        AI ska inte ersätta vuxna relationer. Tekniken ska öka en mentors
        räckvidd och frigöra tid för mänsklig närvaro, uppmuntran och omdöme.

relationship_to_montessori:
  similarities:
    - "Respekt för elevens nyfikenhet och initiativ."
    - "Självständigt arbete."
    - "Läraren eller mentorn fungerar som vägledare."
    - "Möjlighet att arbeta fokuserat med en uppgift under längre tid."
    - "Miljön organiseras så att eleven kan göra meningsfulla val."
  differences_or_extensions:
    - >
      Noden behöver inte följa en ren Montessorimodell utan kan kombinera
      självstyrning med tydliga kunskapsmål och strukturerad progression.
    - >
      AI-systemet kan hjälpa till att identifiera luckor som inte upptäcks när
      eleven enbart följer sitt spontana intresse.
    - >
      Mentorn kan aktivt träna eleven i att följa längre argument och arbeta
      med sådant som ännu inte känns omedelbart motiverande.

vision:
  short_statement: >
    Skapa lokala läranderum där barn får tillgång till återkommande
    intellektuellt och mänskligt stöd, även när det inte finns en utbildad
    lärare tillgänglig för varje barn.
  extended_statement: >
    En lokal AI-modell och en närvarande mänsklig mentor ska tillsammans kunna
    ge flera barn individuell vägledning. AI:n tillhandahåller förklaringar,
    övningar, återkoppling och struktur. Mentorn skapar trygghet, ser barnen,
    hjälper dem att hålla riktningen och tar ansvar för den sociala miljön.
  social_goal: >
    Minska den ojämlikhet som uppstår när bara vissa barn har tillgång till
    utbildade och strategiskt medvetna vuxna i hemmet.

learning_node:
  name: "Lokal läxhjälps- och mentorsnod"
  possible_sites:
    - site: "Mumford"
      potential_role: >
        En lokalt förankrad nod för läxhjälp, läsning, digital kompetens och
        mentorskap för barn och ungdomar.
    - site: "Skeppet"
      potential_role: >
        Ett mobilt eller halvpermanent läranderum där samma modell kan prövas
        i en annan fysisk och social miljö.
  physical_space:
    characteristics:
      - "Tryggt och lugnt."
      - "Tillgång till böcker och lokalt undervisningsmaterial."
      - "Datorer eller energieffektiva terminaler."
      - "Möjlighet till både individuellt arbete och gemensamma samtal."
      - "En vuxen mentor som är synlig och tillgänglig."
      - "Rutiner för fokuserade arbetspass och pauser."
  intended_users:
    - "Barn som behöver läxhjälp."
    - "Barn utan tillgång till utbildade vuxna i hemmet."
    - "Barn som lär sig bättre genom projekt och konkreta mål."
    - "Barn som behöver träna fokus, struktur och studieteknik."
    - "Äldre elever som kan börja fungera som kamratmentorer."

human_mentor_model:
  core_idea: >
    Personen i rummet behöver inte alltid vara legitimerad lärare. Rollen kan
    vara mentor, handledare, bibliotekarie, student, förälder, pensionär eller
    annan ansvarsfull vuxen med lämplig introduktion och stöd.
  mentor_responsibilities:
    - "Skapa trygghet och ordning i rummet."
    - "Hjälpa barnen att formulera vad de försöker göra."
    - "Observera frustration, utanförskap och konflikter."
    - "Uppmuntra uthållighet utan att skambelägga."
    - "Hjälpa barnet att värdera AI:ns svar kritiskt."
    - "Avgöra när en fråga kräver en utbildad lärare eller annan specialist."
    - "Följa barnens utveckling över tid."
    - "Skydda barnens integritet."
  mentor_does_not_need_to:
    - "Kunna varje skolämne på avancerad nivå."
    - "Själv producera alla förklaringar och övningar."
    - "Ge individuell undervisning till samtliga barn samtidigt."
  ai_enabled_scaling:
    description: >
      AI:n kan hjälpa flera barn parallellt medan mentorn rör sig mellan dem.
      Varje barn kan få en individuell dialog, men mentorn behåller överblick
      över gruppen och kan ingripa där mänskligt omdöme behövs.
  supervision_interface:
    possible_features:
      - "Översikt över vad varje elev arbetar med."
      - "Markering när en elev verkar fastna eller bli frustrerad."
      - "Sammanfattning av vilka begrepp som behandlats."
      - "Förslag på frågor mentorn kan ställa."
      - "Varning vid känsligt, osäkert eller olämpligt innehåll."
      - "Möjlighet för mentorn att godkänna eller korrigera en studieplan."
      - "Ingen dold rangordning av barn."

local_model_strategy:
  principle: "Lokal modell, lokal kunskap, lokala behov och lokal kontroll."
  reasons_for_local_models:
    - "Kan fungera vid svag eller dyr internetanslutning."
    - "Minskar beroendet av externa leverantörer."
    - "Gör det möjligt att skydda barns data."
    - "Kan anpassas till lokala språk och uttryck."
    - "Kan använda material som är relevant för den lokala undervisningen."
    - "Kan drivas på lokal hårdvara och fortsätta fungera offline."
  knowledge_sources:
    possible_material:
      - "Lokala läroböcker."
      - "Nationella och regionala läroplaner."
      - "Lärarhandledningar."
      - "Tidigare prov och övningsmaterial där användningen är tillåten."
      - "Lokala berättelser, historia och geografi."
      - "Material på lokala språk."
      - "Praktisk kunskap från lokala yrken och samhällsfunktioner."
      - "Lokala bibliotekssamlingar och öppet licensierade resurser."
      - "Material som produceras av lokala lärare och mentorer."
  implementation_methods:
    preferred_early_methods:
      - "Retrieval-augmented generation över en granskad lokal kunskapsbas."
      - "Lokala embeddings och lokal dokumentsökning."
      - "Tydlig märkning av källa för varje faktabaserat svar."
      - "Små, testbara system före omfattande finjustering."
    possible_later_methods:
      - "Finjustering på lokalt framtagna pedagogiska dialoger."
      - "Destillation till mindre modeller som kan köras på billigare hårdvara."
      - "Flerspråkig anpassning."
      - "Lokalt utvecklade utvärderingsdataset."
  model_behavior:
    requirements:
      - "Ställa frågor innan den ger hela svaret."
      - "Anpassa förklaringen efter elevens aktuella nivå."
      - "Inte automatiskt göra läxan åt eleven."
      - "Visa mellanled när det är pedagogiskt relevant."
      - "Träna eleven i att själv förklara sitt resonemang."
      - "Uppmuntra kontroll av källor och egna slutsatser."
      - "Kunna säga att den är osäker."
      - "Hänvisa vidare till mentorn vid behov."
      - "Använda lokala exempel utan att låsa barnet vid en begränsad värld."
  local_ownership:
    governance:
      - "Lokala lärare och familjer deltar i val av material."
      - "Lokalsamhället kan föreslå och granska innehåll."
      - "Ändringar i kunskapsbasen dokumenteras."
      - "Det ska vara tydligt vem som ansvarar för systemet."
      - "Lokala behov ska styra utvecklingen, inte en extern standardprodukt."

pedagogical_ai_functions:
  learner_dialogue:
    - "Förklara samma begrepp på flera olika sätt."
    - "Koppla teori till elevens vardag och projekt."
    - "Skapa övningar på lämplig svårighetsnivå."
    - "Ge ledtrådar i steg i stället för att genast avslöja svaret."
    - "Be eleven sammanfatta med egna ord."
    - "Identifiera möjliga kunskapsluckor."
  study_structure:
    - "Bryta ned större uppgifter i små steg."
    - "Skapa tydliga arbetspass."
    - "Påminna om tidigare kunskap som behövs."
    - "Växla mellan repetition och nya moment."
    - "Hjälpa eleven att avsluta det som påbörjats."
  metacognition:
    - "Fråga eleven vad som känns svårt."
    - "Synliggöra vilka strategier eleven använde."
    - "Skilja mellan att inte förstå och att inte ha arbetat tillräckligt länge."
    - "Hjälpa eleven att planera, följa upp och reflektera."
  discipline_training:
    - "Gradvis öka längden på fokuserade arbetspass."
    - "Träna läsning av längre texter."
    - "Låta eleven följa sammanhängande argument."
    - "Uppmuntra återgång till en uppgift efter frustration."
    - "Belöna uthållighet och förbättrade arbetsstrategier, inte bara rätt svar."

example_learning_flow:
  scenario: "En elev behöver matematik för ett konkret projekt."
  steps:
    - step: 1
      mentor_action: "Hjälper eleven formulera projektets mål."
      ai_action: "Identifierar vilka matematiska begrepp som behövs."
    - step: 2
      mentor_action: "Säkerställer att projektet är realistiskt och meningsfullt."
      ai_action: "Skapar en kort individuell lärväg."
    - step: 3
      mentor_action: "Observerar fokus och frustration."
      ai_action: "Ger förklaringar, frågor och ledtrådar."
    - step: 4
      mentor_action: "Ber eleven förklara vad som har förståtts."
      ai_action: "Testar förståelsen med en ny variation av problemet."
    - step: 5
      mentor_action: "Kopplar lärandet till ansvar, samarbete och nästa arbetspass."
      ai_action: "Sparar en minimal lokal sammanfattning utan onödiga persondata."

equity_and_access:
  intended_effects:
    - >
      Göra strategiska samtal och individualiserad vägledning tillgängliga för
      barn som annars inte får detta i hemmet.
    - >
      Ge varje barn möjlighet att ställa många frågor utan att känna att det
      stör eller tar för mycket av en vuxens tid.
    - >
      Hjälpa mentorer att stödja fler barn utan att den mänskliga relationen
      försvinner.
    - >
      Göra lokal kunskap och lokala språk till en resurs i utbildningen.
  caution: >
    Systemet får inte bli en billig ersättning för utbildade lärare eller ett
    argument för att minska investeringar i skolor. Det ska komplettera och
    förstärka människor, inte legitimera frånvaro av professionell undervisning.

safety_and_ethics:
  child_safety:
    - "Tydlig vuxennärvaro."
    - "Barn ska inte behöva lämna känsliga personuppgifter."
    - "Loggning ska vara minimal, begriplig och lokalt kontrollerad."
    - "Rutiner behövs för oro kring våld, övergrepp, psykisk ohälsa eller annan utsatthet."
    - "AI:n ska inte försöka agera terapeut, läkare eller myndighetsperson."
  educational_safety:
    - "Svar ska kunna spåras till lokala eller godkända källor."
    - "Osäker information ska markeras."
    - "Mentorer och lärare ska kunna rapportera fel."
    - "Systemet ska testas för systematiska språk- och kulturfel."
    - "Barn ska lära sig att AI kan ha fel."
  social_safety:
    - "Tekniken ska inte isolera barn från varandra."
    - "Rummet ska innehålla gemensamma diskussioner och samarbete."
    - "AI:n ska inte ersätta erkännande, omsorg eller mänskligt ansvar."
    - "Ingen automatiserad etikettering av barn som svaga, lata eller problematiska."

evaluation:
  core_question: >
    Hjälper noden barn att utveckla kunskap, självständighet, fokus och
    framtidstro utan att minska mänsklig kontakt eller lokal kontroll?
  dimensions:
    learning:
      indicators:
        - "Förbättrad begreppsförståelse."
        - "Förmåga att lösa nya problem."
        - "Bättre läsning och skriftlig förmåga."
        - "Ökad förmåga att förklara egna resonemang."
    study_habits:
      indicators:
        - "Längre fokuserade arbetspass."
        - "Fler slutförda uppgifter."
        - "Bättre planering."
        - "Förmåga att återvända efter motgång."
    human_relationships:
      indicators:
        - "Barn upplever att en vuxen ser dem."
        - "Mentorn får mer tid till meningsfulla samtal."
        - "Ökat samarbete mellan barn."
    local_relevance:
      indicators:
        - "Användning av lokala språk och exempel."
        - "Ökad medverkan från lokala lärare och familjer."
