fragment:
  id: "ateruppbyggnad_01"
  title: "Att omförhandla tiden"
  working_title_alternatives:
    - "Återtagandet"
    - "Ett år"
    - "Biologins villkor"
  narrative_position:
    follows:
      - "misshandeln och rånet"
      - "Kroppen som blev kvar"
      - "spegelögonblicket där kroppen övergår från öde till problem"
    precedes:
      - "den etiska prövningen av metoderna"
      - "året av systematisk återuppbyggnad"
      - "de senare fragment där resultatet syns indirekt"
  narrative_function:
    primary: >
      Visa hur han vägrar acceptera att de förlorade åren automatiskt
      måste bli permanent biologisk tid.
    secondary:
      - "återetablera hans medicinska och analytiska förmåga"
      - "visa hur han omvandlar förtvivlan till ett avgränsat projekt"
      - "förena klinisk erfarenhet, filosofi, träning och longevityforskning"
      - "etablera ett tidsbegränsat mål snarare än ett livslångt tvång"
      - "visa pragmatism utan att skriva en konkret farmakologisk manual"
  central_realization:
    statement: >
      Han hade kommit efter.
    elaboration: >
      Medan andra människor fortsatt arbeta, röra sig, träna, älska,
      bygga vardag och åldras gradvis hade hans liv stått stilla.
      De hade inte besegrat tiden, men de hade fått leva i den.
      Själv hade han förlorat år utan att få någonting i utbyte.
    consequence: >
      Han ansåg därför inte att en normal och försiktig återgång var tillräcklig.
      Den som hamnat efter måste under en period röra sig snabbare för att komma ikapp.
  relation_to_biological_age:
    rejection:
      target: "biologisk tid som ett orubbligt öde"
      clarification: >
        Han förnekade inte kronologisk ålder och trodde inte att döden kunde
        avskaffas. Han vägrade däremot acceptera att inaktivitet, stress,
        läkemedel, sömnbrist och social nedbrytning skulle få räknas som
        naturligt åldrande.
    goal: >
      Att under ett år bygga tillbaka kroppen och den kognitiva kapaciteten
      så nära den nivå han haft före sammanbrottet som det rimligen gick.
    time_horizon:
      intensive_phase: "ett år"
      later_phase: >
        Efter den intensiva fasen skulle han övergå till mer konventionella
        och långsiktigt hållbara former av träning, sömn, kost, återhämtning
        och förebyggande medicin.
  naming:
    rejected_term: "rekonstruktion"
    chosen_term: "återtagande"
    distinction: >
      Rekonstruktion antydde att en ny människa skulle byggas.
      Återtagande betydde att kropp, uppmärksamhet, minne och handlingsförmåga
      redan hade tillhört honom och kunde krävas tillbaka.
  intellectual_method:
    fields_he_studies:
      - "longevity och healthspan"
      - "träningsfysiologi"
      - "endokrinologi"
      - "metabol medicin"
      - "sömn och dygnsrytm"
      - "neuroplasticitet"
      - "kognitiv rehabilitering"
      - "stressfysiologi"
      - "filosofi om kropp, identitet och autonomi"
      - "skillnaden mellan behandling, prevention och optimering"
    source_hierarchy:
      core:
        - "vetenskapliga artiklar"
        - "kliniska riktlinjer"
        - "farmakologisk och fysiologisk grundkunskap"
      supplementary:
        - "forskningsprotokoll"
        - "patent"
        - "konferensmaterial"
        - "fallbeskrivningar"
        - "erfarenheter från idrottsmedicin"
      treated_with_caution:
        - "forum"
        - "anekdoter"
        - "kommersiella kliniker"
        - "personliga rapporter om ännu oprövade molekyler"
    principle: >
      Ingen källa fick ensam definiera sanningen.
      Han sökte överlapp mellan mekanism, klinisk erfarenhet,
      mätbara resultat och upprepade observationer.
  philosophical_dimension:
    central_question: >
      När upphör en intervention att vara behandling och blir optimering?
    secondary_questions:
      - >
        Om en kropp har försämrats av sjukdom, passivitet och behandling,
        är återställandet av tidigare funktion vård eller prestationshöjning?
      - >
        Om en hormonnivå ligger inom ett statistiskt normalintervall men långt
        under individens tidigare nivå, vad är då det medicinskt relevanta måttet?
      - >
        Är det moraliskt avgörande vad en intervention kallas,
        eller vilka risker, motiv och konsekvenser den faktiskt har?
      - >
        Finns det en tydlig gräns mellan att förebygga sjukdom,
        återställa funktion och förbättra funktion?
      - >
        När uttrycker regler verklig omsorg och när bär de spår av andra problem,
        såsom tävlingsfusk, kommersiellt missbruk eller rädsla för avvikelse?
    stance: >
      Han ville inte trotsa regler för trotsandets skull.
      Han ville förstå vilka moraliska problem reglerna försökte lösa
      och därefter bedöma om de problemen faktiskt fanns i hans eget fall.
  reconstruction_priorities:
    order:
      - "dygnsrytm"
      - "sömn"
      - "regelbunden rörelse"
      - "styrka"
      - "kondition"
      - "metabol hälsa"
      - "kognitiv uthållighet"
      - "meditation och nervsystemsreglering"
      - "medicinsk korrigering av identifierade brister"
      - "försiktig prövning av mer osäkra interventioner"
    governing_principle: >
      Återställ kroppens förmåga att svara innan signalen förstärks.
    training:
      role: "den viktigaste interventionen"
      progression:
        - "promenader"
        - "lätt styrketräning"
        - "balans och rörlighet"
        - "gradvis ökande konditionsarbete"
        - "belastning i backar"
        - "värme, kyla och återhämtning"
        - "lekfull rörelse när kroppen åter börjat svara"
    cognition:
      targets:
        - "läsa sammanhängande"
        - "behålla flera led i ett resonemang"
        - "minnas avsikter mellan rum"
        - "skriva och avsluta meddelanden"
        - "återfå exekutiv uthållighet"
        - "vara vaken utan att vara jagad"
      measurement_examples:
        - "lästid innan orden glider isär"
        - "arbetsminne"
        - "reaktionstid"
        - "förmåga att avsluta en uppgift"
        - "förmåga att följa ett samtal"
        - "subjektiv och objektiv sömnkvalitet"
  pharmacological_layer:
    explicitness_in_prose: "låg till måttlig"
    narrative_rule: >
      Texten ska inte beskriva preparat, doser eller exakta protokoll.
      Läsaren ska förstå att han ibland använder medicinsk hjälp utöver
      vanliga livsstilsinterventioner, men inte få ett reproducerbart upplägg.
    conventional_elements:
      - "behandling av dokumenterade brister"
      - "medicinsk uppföljning"
      - "laboratorieprover"
      - "periodisk omvärdering"
    boundary_elements:
      - "hormonella insatser i tidsbegränsade cykler"
      - "molekyler som ännu främst förekommer inom forskning"
      - "teoretiskt intressanta interventioner som saknar etablerad marknadsstatus"
    framing: >
      Hormonerna skulle inte ersätta träningen.
      De skulle, om de användes, endast hjälpa en nedreglerad kropp att åter
      svara på träning, sömn, näring och belastning.
    caution:
      - "en förändring i taget"
      - "mätning före och efter"
      - "förutbestämda avbrottskriterier"
      - "inga resultat utan redovisning av kostnader"
      - "ingen framställning av molekylerna som magiska"
  setting_and_structure:
    possible_locations:
      - "Åre under uppbyggnadsfasen"
      - "Ghana under värme-, rörelse- och integrationsfasen"
    spatial_symbolism:
      are: >
        Kyla, höjd, ensamhet, mätning och den långsamma återkomsten av styrka.
      ghana: >
        Värme, social förankring, rörelse, lekfullhet och kroppens återkomst
        till en levd värld.
  key_scenes:
    opening:
      action: >
        Han skriver först REKONSTRUKTION och ersätter det med ÅTERTAGANDE.
    first_measurement:
      elements:
        - "vikt"
        - "midjemått"
        - "vilopuls"
        - "greppstyrka"
        - "gångsträcka"
        - "kognitiv uthållighet"
    first_walk:
      distance: "några hundra meter"
      emotional_element: >
        Han blir passerad av människor som inte vet att promenaden är
        hans första försök att återvända till livet.
      conversion: >
        Skammen registreras som data i stället för att få avsluta försöket.
    temporal_montage:
      examples:
        - "fyrahundra meter blir fyrahundrafemtio"
        - "tio minuters läsning blir tjugo"
        - "små vikter blir systematisk belastning"
        - "en avsikt kan åter bäras från ett rum till ett annat"
  endpoint:
    not_a_miracle: >
      Efter ett år är han inte färdig och inte botad från historien.
      Han har däremot återtagit tillräckligt mycket funktion för att
      nästa fas av livet ska kunna börja.
    transition_line: >
      Det första året handlade om att bygga en människa som kunde återvända.
      Nästa fas skulle handla om vad han skulle återvända till.
  overlap_with_other_fragments:
    with_ateruppbyggnad_02: >
      Detta fragment beskriver vad han beslutar att göra.
      Fragment 02 prövar om han moraliskt har rätt att göra det.
    with_ateruppbyggnad_03: >
      Detta fragment visar processen och intentionen.
      Fragment 03 beskriver den subjektiva erfarenheten när kroppen åter blir ett hem.
    with_ateruppbyggnad_04: >
      Detta fragment innehåller mätningar och metod.
      Fragment 04 ska nästan helt undvika sådana förklaringar och endast låta
      resultaten framträda i vardagliga handlingar.
  avoid:
    - "en katalog över substanser"
    - "exakta doser"
    - "ett triumferande montage där allt fungerar"
    - "påståendet att testosteron eller peptider ensamma räddar honom"
    - "att göra biologisk ålder till ett exakt eller okomplicerat mått"
    - "att reducera hans återkomst till utseende"
    - "att framställa honom som säker på sådant han egentligen bara kan uppskatta"
  tone:
    - "metodisk"
    - "beslutsam"
    - "intellektuellt nyfiken"
    - "pragmatisk"
    - "filosofiskt undersökande"
    - "försiktigt gränsöverskridande"
fragment:
  id: "ateruppbyggnad_02"
  title: "Vetenskap, men inte evangelium"
  working_title_alternatives:
    - "Den moraliska gränsen"
    - "Rätten att bära risken"
    - "Inte en metod för andra"
  narrative_position:
    preferred_placement: >
      Efter att återtagandeprogrammet etablerats men innan läsaren har fått
      se dess fulla resultat.
    alternative_placement: >
      Kan infogas som en reflekterande passage när han för första gången
      överväger en intervention som ligger utanför etablerad behandling.
  narrative_function:
    primary: >
      Låta honom formulera den etiska skillnaden mellan tidigare missbruk
      och det nuvarande, kontrollerade risktagandet utan att låta romanen
      avgöra frågan åt läsaren.
    secondary:
      - "erkänna att hans resonemang kan vara självbedrägeri"
      - "visa att han tar kritiken på allvar"
      - "förhindra att förvandlingen blir reklam"
      - "gestalta filosofiskt tänkande som praktisk moralisk metod"
      - "skilja personlig autonomi från allmän rekommendation"
  opening_provocation:
    line: >
      Det han gjorde var, sett från nästan varje etablerad ordning,
      fullständigt förkastligt.
    function: >
      Meningen uttrycker den tänkta domen från samhället och hans egen
      medvetenhet om den, inte en objektiv författardom.
    possible_softening: >
      Om formuleringen blir för kategorisk kan den ändras till:
      Det han gjorde skulle av många betraktas som fullständigt förkastligt.
  accusations_he_considers:
    - "dopning"
    - "fusk"
    - "missbruk"
    - "kriminalitet"
    - "att ersätta en underkastelse med en annan"
    - "att klä ett tvång i vetenskapligt språk"
    - "att använda medicinsk bildning för att legitimera en drift"
  autobiographical_weight:
    past:
      - "missbruk"
      - "olagliga handlingar"
      - "lögner"
      - "lindring som fortsatte efter att den slutat lindra"
      - "argument som konstruerades efter impulsen"
    insight: >
      Han hade egen erfarenhet av hur ett tvång först handlar och därefter
      uppfinner ett rationellt försvar.
    unresolved_risk: >
      Han kunde därför aldrig helt bevisa för sig själv att samma mekanism
      inte arbetade i honom igen.
  ethical_distinctions:
    controlled_risk_vs_compulsion:
      controlled_risk:
        - "mål formulerat i förväg"
        - "tidsbegränsning"
        - "dokumentation"
        - "förmåga att avbryta"
        - "acceptans av negativa resultat"
        - "ingen successiv doseskalering för sin egen skull"
      compulsion:
        - "målet flyttas efter varje resultat"
        - "risker förnekas"
        - "mätningar ignoreras"
        - "försämring tolkas som behov av mer"
        - "argumenten uppstår först efter handlingen"
    treatment_prevention_optimization:
      treatment: >
        Att korrigera sjukdom eller tydlig funktionsnedsättning.
      prevention: >
        Att minska sannolikheten för framtida sjukdom och förlust av funktion.
      optimization: >
        Att försöka överskrida den nivå som betraktas som tillräckligt normal.
      ambiguity: >
        I hans kropp låg dessa områden över varandra.
        Att återvinna förlorad muskelmassa kunde vara rehabilitering.
        Att återställa hormonell funktion kunde vara behandling.
        Att sikta mot en tidigare, ovanligt hög kapacitet kunde vara optimering.
        Samma åtgärd kunde byta moralisk kategori beroende på syfte och omfattning.
    medicine_vs_performance_enhancement:
      question: >
        Är något moraliskt annorlunda enbart för att det förbättrar prestation?
      contextual_answer: >
        I tävlingsidrott kan förbättringen innebära orättvisa mot andra.
        I hans fall fanns ingen motståndare, inget pris och ingen gemensamt
        accepterad regel som hans kroppsliga återkomst kunde förfalska.
      unresolved_counterpoint: >
        Frånvaron av en tävling gjorde inte interventionen säker,
        klok eller laglig. Den avlägsnade bara ett av de moraliska argumenten.
  philosophical_method:
    approach: >
      Han sökte inte ett citat från en filosof som kunde frikänna honom.
      Han försökte identifiera vilka värden som stod mot varandra.
    values_in_conflict:
      - "autonomi"
      - "icke-skada"
      - "rättslig ordning"
      - "medicinsk försiktighet"
      - "kunskapssökande"
      - "personligt ansvar"
      - "risken att inspirera andra"
      - "rätten till kroppslig självbestämning"
    central_question: >
      Var handlingen fel därför att den skapade konkret skada,
      eller därför att den liknade andra handlingar som ofta gjorde det?
    pragmatic_conclusion: >
      Kategorier var viktiga som varningssystem, men de befriade honom inte
      från skyldigheten att undersöka det enskilda fallet.
  terminology:
    rejected:
      doping:
        reason: >
          Ordet hämtade sin huvudsakliga moraliska laddning från tävling,
          regelbrott och orättvisa fördelar.
      biohacking:
        reason: >
          Ordet fick kroppen att låta som en enkel maskin och experimentet
          som en lek utan historia, lidande eller ansvar.
    preferred_description:
      options:
        - "medicinsk självrekonstruktion"
        - "ett tidsbegränsat återtagandeprogram"
        - "experimentell rehabilitering"
        - "medicin under belägring"
      caution: >
        Ingen beteckning får helt lösa den moraliska osäkerheten.
  epistemic_position:
    claim: >
      Kemiska ämnen följer biologiska mekanismer, inte administrativa kategorier.
    necessary_correction: >
      Att kategorier är administrativt skapade innebär inte att de är
      betydelselösa. De kan bära samlad erfarenhet av risk, missbruk,
      exploatering och skada.
    mature_position: >
      Han vägrar både blind lydnad och blind trots.
      Han försöker förstå varför en gräns finns innan han avgör om den
      är relevant för den handling han överväger.
  personal_rules:
    governing_statement: >
      Detta fick vara vetenskap, men aldrig evangelium.
    commitments:
      - "dokumentera även misslyckanden"
      - "redovisa kostnader tillsammans med vinster"
      - "inte bygga en rörelse"
      - "inte sälja en metod"
      - "inte rekommendera andra att imitera honom"
      - "inte visa kroppen som bevis utan att visa osäkerheten"
      - "avbryta vid förutbestämda varningssignaler"
      - "aldrig låta styrka eller ungdomlighet bli ett argument i sig"
    discretion:
      motive: >
        Diskretionen kommer inte främst ur skam utan ur insikten att
        berättelser om förvandling gör människor blinda för priset.
      literary_effect: >
        Läsaren får förstå att något ovanligt har skett men lämnas utan
        ett färdigt recept eller en heroiserad genväg.
  relation_to_legality:
    position: >
      Han anser inte att laglighet ensam avgör moralisk riktighet.
    limitation: >
      Han anser inte heller att personlig övertygelse upphäver lag,
      konsekvenser eller ansvar.
    conflict: >
      Han är beredd att bära följderna av sina val men vägrar låta
      myndighetskategorier ersätta den moraliska analysen.
  core_goal:
    not_longevity: >
      Han är inte i första hand intresserad av att förlänga livet.
    desired_quality:
      - "närvaro"
      - "minnets bärighet"
      - "förmågan att fullfölja en tanke"
      - "fysisk rörelse utan hinder"
      - "vakenhet utan förföljelsekänsla"
      - "lugn utan bedövning"
    key_line: >
      Han försökte inte lura biologin.
      Han försökte förstå den tillräckligt väl för att omförhandla sina villkor.
  ending:
    central_claim: >
      Hans gränsöverskridande bestod inte i att han trodde sig stå över riskerna.
    final_line: >
      Det bestod i att han ansåg sig ha rätt att bära dem själv.
    retained_ambiguity: >
      Romanen ska inte helt bekräfta att han har rätt.
      Läsaren ska kunna se både integriteten och övermodet i samma hållning.
  overlap_with_other_fragments:
    with_ateruppbyggnad_01: >
      Fragment 01 beskriver programmet som ett praktiskt och medicinskt projekt.
      Detta fragment förhindrar att projektet framstår som självklart legitimt.
    with_ateruppbyggnad_03: >
      Fragment 03 visar ett djupt positivt resultat.
      Detta fragment måste finnas för att resultatet inte ska fungera som
      ett automatiskt moraliskt frikännande av alla metoder.
    with_ateruppbyggnad_04: >
      I fiskarfragmentet undanhåller han den mest riskfyllda delen när han
      blir tillfrågad. Denna diskretion följer direkt ur principen här:
      han vill inte göra sin egen förvandling till råd för andra.
  productive_tensions:
    - >
      Han är läkare och försöksperson samtidigt, vilket ger både kunskap
      och en allvarlig risk för bristande distans.
    - >
      Han dokumenterar för att minska självbedrägeri men kan också använda
      dokumentationen för att ge tvånget en vetenskaplig form.
    - >
      Han försvarar autonomi men vet att hans berättelse kan påverka andra.
    - >
      Han avvisar blind moralism men riskerar att underskatta den historiska
      erfarenhet som moraliska normer ofta bygger på.
  avoid:
    - "att framställa alla läkemedelskategorier som godtyckliga"
    - "att likställa lagligt med ofarligt eller olagligt med irrationellt"
    - "att låta hans medicinska utbildning fungera som fullständig garanti"
    - "att låta goda resultat retroaktivt göra alla risker försvarliga"
    - "att göra monologen till ett manifest för självmedicinering"
    - "att lösa den moraliska frågan helt"
  tone:
    - "självkritisk"
    - "filosofisk"
    - "provokativ men inte triumferande"
    - "analytisk"
    - "moraliskt osäker"
    - "personligt ansvarstagande"
fragment:
  id: "ateruppbyggnad_03"
  title: "Hemma"
  working_title_alternatives:
    - "Kroppen svarade"
    - "Kraft utan brådska"
    - "Att bo i sig själv"
  narrative_position:
    placement: >
      Efter den intensiva återuppbyggnadsfasen men före de senare scener
      där omgivningen gradvis upptäcker förändringen.
    function_in_sequence: >
      Detta är den inre motsvarigheten till fiskarfragmentets yttre gestaltning.
  narrative_function:
    primary: >
      Beskriva att den egentliga framgången inte är muskler, ungdomlighet
      eller mätvärden utan att han åter kan vara närvarande i kroppen.
    secondary:
      - "förena vitalitet med lugn"
      - "visa att traumat inte längre organiserar varje rörelse"
      - "skildra en kropp som svarar utan friktion"
      - "visa kognitiv och emotionell förändring"
      - "undvika en banal före-och-efter-skildring"
  opening:
    key_lines:
      - "Han kände sig hemma i kroppen på riktigt."
      - "Inte bara stark."
      - "Inte bara frisk."
      - "Hemma."
    relation_to_previous_body_fragment: >
      I Kroppen som blev kvar stod kroppen som ett övergivet hus.
      Här blir samma metafor fullbordad: han har återvänt och börjat bo där igen.
  embodied_change:
    before:
      - "kroppen var ett föremål"
      - "den släpades genom dagarna"
      - "den var tung, svullen och motvillig"
      - "viljan saknade förbindelse med musklerna"
      - "han behövde lämna kroppen för att stå ut"
    after:
      - "kroppen bär honom utan friktion"
      - "den svarar innan tvivlet hinner uppstå"
      - "rörelse känns självklar"
      - "balans och vighet har återkommit"
      - "han kan känna tyngd utan att uppleva den som en börda"
  physical_expression:
    qualities:
      - "stark"
      - "vital"
      - "vig"
      - "koordinerad"
      - "uthållig"
      - "lekfull"
    illustrative_actions:
      - "springer de sista hundra metrarna uppför en sluttning"
      - "hoppar mellan stenar"
      - "tar trappor flera steg åt gången"
      - "står på händer mot en vägg"
      - "söker lek snarare än enbart fart på snowboard"
